{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClosofCode IDE",
  "version": "0.1.0",
  "identifier": "ai.closofcode.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4444",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "ClosofCode IDE",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
